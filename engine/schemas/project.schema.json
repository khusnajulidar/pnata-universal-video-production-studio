{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "P'Nata Video Project",
  "type": "object",
  "required": ["title", "width", "height", "fps", "policy", "scenes"],
  "properties": {
    "title": {"type": "string", "minLength": 1},
    "width": {"type": "integer", "minimum": 16},
    "height": {"type": "integer", "minimum": 16},
    "fps": {"type": "number", "exclusiveMinimum": 0},
    "crf": {"type": "integer", "minimum": 0, "maximum": 51, "default": 20},
    "policy": {"type": "object", "required": ["music", "complete_living_beings"],
      "properties": {"music": {"const": "forbidden"}, "complete_living_beings": {"const": "forbidden"}}},
    "scenes": {"type": "array", "minItems": 1, "items": {"type": "object",
      "required": ["duration"], "properties": {"duration": {"type": "number", "exclusiveMinimum": 0},
      "image": {"type": "string"}, "visual_reviewed_policy_compliant": {"type": "boolean"},
      "title": {"type": "string"}, "text": {"type": "string"}, "background": {"type": "string"}}}},
    "audio": {"type": "array", "items": {"type": "object",
      "required": ["path", "role", "human_reviewed_non_musical"],
      "properties": {"path": {"type": "string"}, "role": {"enum": ["voiceover", "speech", "sfx", "ambience"]},
      "human_reviewed_non_musical": {"const": true}, "start": {"type": "number", "minimum": 0},
      "volume": {"type": "number", "minimum": 0, "maximum": 2}}}}
  }
}
